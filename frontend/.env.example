# Copy to .env.local to override. No secrets belong here: everything prefixed
# VITE_ is compiled into the public JavaScript bundle.

# Where the page sends API requests. "/api" goes through the Vite dev/preview
# proxy (recommended; no CORS needed).
VITE_API_BASE_URL=/api

# Seconds between refreshes in real mode (minimum 30). The backend caches
# results for 300 s, so faster polling does not reach the data providers.
VITE_POLL_SECONDS=60

# Used only by the Vite dev/preview server (not exposed to the page): where the
# Python API is listening.
API_PROXY_TARGET=http://127.0.0.1:8765
